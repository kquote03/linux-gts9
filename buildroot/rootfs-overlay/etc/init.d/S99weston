#!/bin/sh
# Auto-start seatd (session/seat management weston links against -- no
# systemd-logind here) and a minimal Weston + weston-terminal session on
# the DRM backend. Runs as root directly on tty1: no separate user/session
# management needed at this bring-up scale, and weston's DRM backend
# works fine run this way (libseat's "seatd" backend just needs the seatd
# daemon reachable over its default /run/seatd.sock).
#
# No Mesa/EGL/GBM is built into this rootfs (see buildroot/configs/x716_defconfig
# and docs/porting-log.md's Session 5 entry) -- weston's DRM backend falls
# back to its pixman (CPU) renderer automatically, using plain KMS dumb
# buffers. That's enough to prove the panel works; GPU acceleration is a
# later stretch goal, not needed here.
RUNTIME_DIR=/run/user/0

start() {
	# libseat has a "builtin" backend that works standalone as root with
	# no separate seatd daemon at all (confirmed from a real weston.log:
	# "Trying libseat launcher... Started embedded seatd ... libseat:
	# session control granted" -- happens automatically, nothing to start
	# here). A real seatd binary isn't even installed on this rootfs
	# (weston's own BR2_PACKAGE_SEATD selection notwithstanding) but
	# nothing needs it -- kept as a guarded, non-fatal attempt in case a
	# future rootfs does ship one and prefers it.
	if [ -x /usr/bin/seatd ]; then
		echo "Starting seatd"
		/usr/bin/seatd -g root &
		sleep 1
	fi

	mkdir -p "$RUNTIME_DIR"
	chmod 0700 "$RUNTIME_DIR"
	export XDG_RUNTIME_DIR="$RUNTIME_DIR"

	# --continue-without-input: touchscreen isn't wired up yet (explicit
	# non-goal) and there's no physical keyboard/mouse, so libinput finds
	# zero seats -- Weston's DRM backend otherwise treats that as fatal
	# ("failed to create input devices" / "failed to create compositor
	# backend", confirmed from a real weston.log run on-device). This is
	# Weston's own documented flag for exactly this kiosk/no-input
	# scenario (doc/sphinx/toc/running-weston.rst), not a hidden workaround.
	# --tty=1 was tried first and made weston fail later, at shell-module
	# load time, with "fatal: unhandled option: --tty=1" (confirmed live
	# on-device -- DRM backend init itself succeeds either way, so this
	# isn't a DRM/VT issue, just an argument weston 15.0.1 doesn't want
	# here). Omitted; weston picks a VT on its own without it.
	echo "Starting weston"
	/usr/bin/weston --backend=drm-backend.so \
		--continue-without-input \
		--log=/var/log/weston.log &

	# weston-terminal is a plain Wayland client -- give the compositor
	# a moment to create its socket before launching it.
	sleep 3
	XDG_RUNTIME_DIR="$RUNTIME_DIR" /usr/bin/weston-terminal &
}

stop() {
	killall weston-terminal 2>/dev/null
	killall weston 2>/dev/null
	killall seatd 2>/dev/null
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart)
		stop
		sleep 1
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
