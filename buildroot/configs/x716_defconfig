BR2_aarch64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
# weston depends on BR2_INSTALL_LIBSTDCPP (a plain internal flag with no
# prompt of its own -- confirmed by building this defconfig and finding
# BR2_PACKAGE_WESTON silently absent from the resolved .config with no
# warning, then tracing the actual unmet dep to here:
# package/gcc/Config.in.host's "Enable C++ support").
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Buildroot produces the rootfs only -- the kernel/DTB stay owned by this
# repo's own scripts/build-mainline-kernel.sh (see docs/porting-log.md's
# Session 5 entry).
# BR2_LINUX_KERNEL is not set

BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyGS0"

# Dynamic /dev via devtmpfs + eudev -- eudev (not busybox mdev) is what
# actually provides the BR2_PACKAGE_HAS_UDEV weston depends on.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# Weston + weston-terminal, DRM backend, no Mesa/GPU at all (see
# docs/porting-log.md's Session 5 entry for why: pixman/dumb-KMS-buffer
# software rendering is enough to prove the panel works, and sidesteps
# Adreno GPU firmware loading entirely). weston-terminal isn't a separate
# Buildroot package in this release -- it's one of weston's own bundled
# "tools" (upstream weston.mk always passes
# -Dtools=calibrator,debug,info,terminal,touch-calibrator), so plain
# BR2_PACKAGE_WESTON=y is enough to get it built.
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DEFAULT_DRM=y

# Font for weston-terminal -- DejaVu Sans Mono specifically (a monospace
# family; the plain DejaVu Sans default wouldn't render a terminal well).
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_MONO=y


# WiFi/BT bring-up (Networking bring-up Session 8): real userspace test
# tools, now that ath11k/hci_qca both load real firmware on real hardware
# -- see docs/porting-log.md. `iw` for a real WiFi scan
# (`iw dev wlan0 scan`); `bluez-utils` (with its CLIENT sub-option, i.e.
# `bluetoothctl`) for a real BT scan -- matching this project's own
# standard of not accepting "the driver probes"/"firmware loads" as proof
# without an actual signal.
BR2_PACKAGE_IW=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y

# Real WiFi association (not just scanning) + SSH, to get off the slow
# USB-serial console for day-to-day iteration. wpa_supplicant joins the
# real network (config staged in the rootfs-overlay, see
# buildroot/rootfs-overlay/etc/wpa_supplicant.conf); busybox's own
# udhcpc (already enabled in the default busybox config, no change
# needed there) gets a real IP once associated -- both driven by
# buildroot/rootfs-overlay/etc/init.d/S45wifi-connect (new). dropbear is
# a small SSH2 server, simpler than pulling in full OpenSSH for a
# bring-up image; a static root password (set below) is enough for a
# private LAN-only device like this.
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_DROPBEAR=y
BR2_TARGET_GENERIC_ROOT_PASSWD="tabs9root"

# wpa_cli (real-time wpa_supplicant status/control, e.g. `wpa_cli status`)
# needs CONFIG_CTRL_IFACE compiled in -- this sub-option selects it
# automatically. Once this lands, the `ctrl_interface=` directive in
# buildroot/rootfs-overlay/etc/wpa_supplicant.conf becomes valid again
# (re-added there) -- see that file's own comment for why it was
# removed in the first place (CONFIG_CTRL_IFACE wasn't compiled in yet).
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y

# Diagnostic: real WiFi association works (real IP, real ping RTTs) but
# inbound TCP (SSH) times out with no RST -- ICMP-fine/TCP-silently-dead
# is a known symptom class for a checksum-offload bug in a new WiFi
# driver's RX/TX path (ath11k here is genuinely new to this exact
# hw_rev). ethtool -K is the only userspace tool that can even inspect/
# toggle NIC checksum offload (no sysfs equivalent) -- added to test
# this concretely rather than guess. See docs/porting-log.md's
# Networking bring-up session for the result.
BR2_PACKAGE_ETHTOOL=y

# General debugging/dev goodies for this bring-up rootfs, now that a
# real network path (SSH) makes it worth having them on hand:
# - netcat: busybox's own `nc` applet is disabled in the default
#   busybox config this project uses; the standalone GNU netcat package
#   is simpler than forking a busybox config fragment just for one
#   applet. netcat-openbsd (glibc-only) isn't compatible with this
#   musl toolchain -- plain BR2_PACKAGE_NETCAT works with any libc.
# - tcpdump: real packet capture on-device, directly useful for the
#   networking bring-up work this whole session has been doing.
# - pciutils (lspci): verify the WLAN PCIe endpoint from userspace,
#   matching this project's own "prove the bus works" discipline.
# - usbutils (lsusb): same idea for the USB gadget/host side.
# - htop, strace: general process/syscall debugging.
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_NETCAT=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_USBUTILS=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_STRACE=y

BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
