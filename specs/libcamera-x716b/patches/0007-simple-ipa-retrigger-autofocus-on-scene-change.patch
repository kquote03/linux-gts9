-std::optional<int32_t> IPASoftSimple::processFocusStats(uint64_t score)
+/*
+ * Total-variation distance between two luminance histograms: 0 for identical
+ * distributions, 1 for disjoint ones.
+ */
+static double histogramDistance(const SwIspStats::Histogram &a,
+				const SwIspStats::Histogram &b)
+{
+	uint64_t sumA = 0, sumB = 0;
+	for (unsigned int i = 0; i < a.size(); ++i) {
+		sumA += a[i];
+		sumB += b[i];
+	}
+	if (!sumA || !sumB)
+		return 0.0;
+
+	double d = 0.0;
+	for (unsigned int i = 0; i < a.size(); ++i)
+		d += std::abs(static_cast<double>(a[i]) / sumA -
+			      static_cast<double>(b[i]) / sumB);
+	return d / 2;
+}
+
+/*
+ * Decide, while locked, whether the scene changed enough to focus again. A
+ * change is only acted on once the scene has held still for a couple of
+ * statistics (or after a bounded wait for a scene that never does), so a hand
+ * moving through the frame is not chased.
+ */
+bool IPASoftSimple::afSceneChanged(uint64_t score, const SwIspStats &stats)
+{
+	/* Luminance histogram distance to the reference that means "changed". */
+	constexpr double kSceneChange = 0.25;
+	/* Distance between consecutive statistics that means "settled". */
+	constexpr double kSettled = 0.10;
+	/* Give up waiting for the scene to settle after this many statistics. */
+	constexpr unsigned int kMaxWait = 16;
+
+	/* Take the reference a few statistics after locking, once AGC settled. */
+	if (afRefStats_) {
+		if (--afRefStats_ == 0) {
+			afRefHist_ = stats.yHistogram;
+			afPrevHist_ = stats.yHistogram;
+			afRefScore_ = score;
+		}
+		return false;
+	}
+
+	double dRef = histogramDistance(stats.yHistogram, afRefHist_);
+	double dPrev = histogramDistance(stats.yHistogram, afPrevHist_);
+	afPrevHist_ = stats.yHistogram;
+
+	LOG(IPASoft, Debug) << "AF locked: histogram distance " << dRef
+			    << " (to previous " << dPrev << "), score " << score
+			    << " (reference " << afRefScore_ << ")";
+
+	if (!afChanged_) {
+		bool differs = dRef > kSceneChange ||
+			       (afRefScore_ && (score * 10 < afRefScore_ * 6 ||
+						score * 10 > afRefScore_ * 16));
+		afChangeStats_ = differs ? afChangeStats_ + 1 : 0;
+		if (afChangeStats_ < 2)
+			return false;
+
+		afChanged_ = true;
+		afChangedFor_ = 0;
+		afStableStats_ = 0;
+		LOG(IPASoft, Debug) << "AF: scene changed, waiting for it to settle";
+	}
+
+	afChangedFor_++;
+	afStableStats_ = dPrev < kSettled ? afStableStats_ + 1 : 0;
+	if (afStableStats_ >= 2 || afChangedFor_ >= kMaxWait) {
+		LOG(IPASoft, Debug) << "AF: scene settled, focusing again";
+		return true;
+	}
+
+	return false;
+}
+
+std::optional<int32_t> IPASoftSimple::processFocusStats(uint64_t score,
+							const SwIspStats &stats)
 {
 	if (afPhase_ == AfPhase::Idle)
 		return std::nullopt;
@@ -436,7 +535,8 @@ std::optional<int32_t> IPASoftSimple::processFocusStats(uint64_t score)
