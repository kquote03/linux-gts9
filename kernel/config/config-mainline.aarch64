# Generic (not board-specific) quality-of-life additions on top of
# `make ARCH=arm64 defconfig`, applied via scripts/kconfig/merge_config.sh.
#
# defconfig at the pinned v7.2 tag already provides a fairly complete
# distro-capable aarch64 base (DEVTMPFS+MOUNT, EXT4_FS, BLK_DEV_INITRD,
# etc. all =y -- verified by reading arch/arm64/configs/defconfig directly,
# not assumed) -- this fragment only adds what bring-up debugging needs on
# top of that.

# Needed for the dyndbg="file drivers/base/dd.c +p" style cmdline debug
# flags planned for Phase 2/3 probe-hang bisection.
CONFIG_DYNAMIC_DEBUG=y

# Kernel log timestamps -- needed to correlate hang timing against sec-log
# capture readback, since there's no live console to watch in real time.
CONFIG_PRINTK_TIME=y

# Lets a later session verify exactly which config actually built a given
# kernel via /proc/config.gz, without needing this repo's build artifacts.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# defconfig's default CONFIG_DEBUG_INFO=y (DWARF, "reduced" variant) still
# makes the final vmlinux.o link step memory-hungry enough to get OOM-killed
# on this dev machine (a shared 14GB desktop, not a dedicated build box --
# confirmed by reproducing the failure: compiles succeeded cleanly through
# every object file at -j4, only the single, unparallelizable final `LD
# vmlinux.o` step got killed). No debugger session is planned for this
# bring-up, so disable debug info entirely rather than fighting the link
# step's memory footprint.
CONFIG_DEBUG_INFO_NONE=y
