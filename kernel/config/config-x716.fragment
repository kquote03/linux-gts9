# Board-specific config for the Samsung Galaxy Tab S9 5G (SM-X716B).
# Applied on top of `make ARCH=arm64 defconfig` + config-mainline.aarch64
# via scripts/kconfig/merge_config.sh.
#
# Everything hardware-critical for this bring-up MVP is forced built-in
# (=y, not =m) -- there's no shell to modprobe from until the rootfs
# itself is reachable, and Phase 2/3 debugging has to work with whatever
# the kernel does on its own before any userspace runs at all.
#
# Confirmed by reading arch/arm64/configs/defconfig and the relevant
# Kconfig/Makefile files directly at the pinned v7.2 tag -- not guessed:

# TLMM pin controller for this SoC (drivers/pinctrl/qcom/pinctrl-sm8550.c,
# matched via "qcom,sm8550-tlmm" in sm8550.dtsi). NOT present at all in
# defconfig (off by default) -- this is the single most important addition
# in this fragment. Without it, essentially nothing that depends on pin
# muxing works, likely including the uart7 console pins this board's DTS
# enables.
CONFIG_PINCTRL_SM8550=y

# UFS transport for this SoC (drivers/ufs/host/ufs-qcom.c). defconfig sets
# this =m; forced =y here since it's this board's only rootfs storage path
# and there's no way to modprobe it before a rootfs is reachable.
CONFIG_SCSI_UFS_QCOM=y

# TrustZone/SCM calls -- selected transitively by several drivers this
# board needs (regulators, UFS reset, etc.) but has no direct defconfig
# entry (it's a bare `tristate` with no prompt, pulled in via `select`).
# Setting it explicitly here is a safety net to force the built-in form
# rather than leaving it to whatever the first selecting driver's own
# module/built-in choice happens to be.
CONFIG_QCOM_SCM=y

# Already =y in defconfig at the pinned tag -- listed here as documentation
# of what this board relies on from the generic base, not because the
# fragment needs to re-set them: CONFIG_ARCH_QCOM, CONFIG_SERIAL_QCOM_GENI,
# CONFIG_SERIAL_QCOM_GENI_CONSOLE, CONFIG_QCOM_GENI_SE, CONFIG_QCOM_RPMH,
# CONFIG_QCOM_SMEM, CONFIG_REGULATOR_QCOM_RPMH, CONFIG_SCSI_UFSHCD,
# CONFIG_SCSI_UFSHCD_PLATFORM, CONFIG_PHY_SAMSUNG_UFS, CONFIG_EXT4_FS.

# sec-log bring-up console (kernel/drivers/samsung-x716-sec-log.c) -- the
# primary Phase 2/3 console-less debug channel. Installed into
# drivers/misc/ by scripts/build-mainline-kernel.sh.
CONFIG_X716_SEC_LOG=y

# Lockup/hang detection, forced to panic (then auto-reboot via the
# cmdline's panic=10). Added 2026-09-05 after attempts 9/10 hung silently
# (no Oops/panic, no auto-reset) instead of crashing -- with no display
# and no way to see a hang in progress, every hang otherwise requires a
# manual hardware reset, and each manual reset attempt writes enough TWRP
# preamble noise into the small (2 MiB) sec-log ring buffer to overwrite
# whatever our own kernel had managed to log before hanging. Turning a
# silent hang into a bounded panic+reboot removes the user from that loop
# entirely and keeps the ring buffer far less contaminated by the time a
# capture is taken. Note: ABL appends its own "nowatchdog" to the cmdline
# (visible in captures, logged as an "Unknown kernel command line
# parameter" since this kernel didn't recognize it before this change)
# which would otherwise neutralize a *cmdline-only* watchdog approach --
# these detectors are turned on by Kconfig default instead, not by a
# cmdline flag, so ABL's injected "nowatchdog" can't disable them the same
# way (nowatchdog's actual effect, once CONFIG_LOCKUP_DETECTOR exists, is
# nosoftlockup+nohardlockup -- verify this doesn't reappear as a problem
# if lockup detection still doesn't fire).
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=15
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1

# simplefb: inherits ABL's already-configured boot-splash scanout buffer
# for a plain fbcon text console -- no real panel/DRM driver needed. Added
# 2026-09-05 alongside the DTS's "simple-framebuffer" node (see
# kernel/dts/sm8550-samsung-x716b.dts's chosen node) once the sec-log/
# last_kmsg channel proved unable to survive the boot-cycle-to-reach-TWRP
# transition for late-boot events. Built-in (=y), not =m: no rootfs/modprobe
# exists yet at this bring-up stage. CONFIG_FB/CONFIG_FRAMEBUFFER_CONSOLE
# are already =y in defconfig at the pinned tag.
#
# Kept alongside the new DRM/panel stack below (Session 5): harmless
# coexistence, not a conflict -- simplefb only claims ABL's splash_region
# scanout early in boot as a fallback text console, and doesn't touch or
# get touched by the real msm/dpu driver's own (separate) framebuffer once
# that probes. Gives two independent chances to see *something* on the
# panel while the real DRM/panel bring-up is unproven.
CONFIG_FB_SIMPLE=y

# exFAT, for writing bring-up logs to the already-inserted, already-exFAT
# -formatted microSD card (kernel/dts/sm8550-samsung-x716b.dts's &sdhc_2).
# Added 2026-09-05: the sec-log/last_kmsg ring buffer (2 MiB, shared with
# ABL/XBL's own verbose preamble) proved unable to survive the mandatory
# reboot-to-TWRP transition needed just to read it back, erasing late-boot/
# userspace evidence on every attempt. A file written to the SD card
# persists across any number of subsequent reboots. CONFIG_MMC_SDHCI_MSM
# is already =y in defconfig at the pinned tag -- only exFAT support itself
# was missing.
CONFIG_EXFAT_FS=y

# USB gadget console/network. Was CONFIG_USB_G_SERIAL=y (a simple legacy
# serial-only gadget, ttyGS0) since 2026-09-05 -- switched to CONFIG_USB_ETH
# (g_ether, legacy CDC-ECM/subset network gadget, real Fedora rootfs pivot)
# after the serial console proved unreliable for actual interactive use
# post-pivot (a real bug was found and fixed in the custom serial-getty
# unit's agetty arg order, but even after that fix the serial line
# produced no output on a second real-hardware test -- not fully root-
# caused given the more direct path below, so abandoned for USB net
# instead of continuing to debug it blind). g_ether needs no userspace
# configfs setup either (same "no modprobe available" reasoning as
# g_serial had) -- it creates a "usb0" network interface automatically
# at boot, matching what rootfs/overlay's gts9wifi-usb-gadget script
# already expects and configures (172.16.42.1/24, gts9wifi-fedora's own
# real design -- see docs/porting-log.md).
CONFIG_USB_ETH=y

# Full USB Type-C stack (sm5714 TCPM + ps5169 redriver + ptn3222 eUSB2
# repeater), added 2026-09-05 after a minimal HS-only gadget attempt (no
# role-switch/redriver at all) failed to enumerate on the host -- the
# external redriver most likely does real, necessary Type-C lane-routing
# work, not just signal conditioning. Drivers installed by
# scripts/build-mainline-kernel.sh from kernel/drivers/{sm5714_battery,
# sm5714_usbpd,ps5169}.c (ubuntu-galaxy-tab-s9ultra originals, GPL-2.0,
# proven on the SM-X910 Ultra -- same SoC generation). All built-in (=y),
# not modules -- no rootfs/modprobe exists at this bring-up stage.
# TYPEC_DP_ALTMODE was deliberately excluded here (CONFIG_DRM was =m at
# the time, and modules were useless with no rootfs/modprobe yet) -- that
# no longer applies (CONFIG_DRM=y below, since the panel/GPU work landed),
# so it's re-added as part of the gts9wifi-fedora pivot's speaker/DP/PPS
# DTS additions (kernel/dts/sm8550-samsung-x716b.dts, &sm5714_connector's
# `displayport = <&mdss_dp0>;` + altmodes block, &mdss_dp0). See Phase 2 of
# docs/porting-log.md's gts9wifi-fedora pivot entry for the rest of the
# config symbols those DTS nodes need (CS35L45, SM5440, ADSP/Q6 audio) --
# not yet merged as of this fragment edit, so none of that new DTS content
# is live until they land.
CONFIG_TYPEC_DP_ALTMODE=y
# The actual root cause of "zero i2c adapters, zero USB chip drivers ever
# probed" (found 2026-09-05 after all i2c-bus-level DTS wiring checked out
# fine and even the bus *controllers* themselves showed zero adapters via
# a userspace /sys check): CONFIG_I2C_QCOM_GENI defaults to =m in
# defconfig, and with no rootfs/modprobe at this bring-up stage, a module
# never loads -- so i2c6/i2c12/i2c_hub_8/i2c_hub_9 (all "qcom,geni-i2c"/
# "qcom,geni-i2c-master-hub") never had a working driver at all, before
# ever reaching the question of whether ptn3222/ps5169/sm5714's own
# regulators were guessed correctly.
# Same class of bug as CONFIG_I2C_QCOM_GENI above, found 2026-09-05 the
# same way (a userspace /sys platform-driver-bound check, reported via
# vibration codes): CONFIG_PHY_SNPS_EUSB2 (the driver for usb_1_hsphy,
# "qcom,sm8550-snps-eusb2-phy") also defaults to =m in defconfig. With no
# module ever loading, usb_1_hsphy never binds, which means it never
# calls phy_init() on ptn3222 (the eUSB2 repeater) either -- even though
# ptn3222 itself binds fine as an i2c client, its regulators/reset are
# gated behind that phy_init() call and never actually get enabled. This
# is the most likely full explanation for the USB PHY's persistent
# "low-speed misdetection, stall on first descriptor" symptom: the D+/D-
# lines were never coming out of an undefined/reset state at all.
# Fourth instance of this exact bug class this session (module defaults
# with no modprobe available), found 2026-09-05: CONFIG_PHY_QCOM_QMP_COMBO
# (the USB3/DisplayPort combo PHY driver for usb_dp_qmpphy,
# "qcom,sm8550-qmp-usb3-dp-phy") also defaults to =m. dwc3_core_probe()
# needs to resolve BOTH entries in usb_1's `phys` list (usb_1_hsphy AND
# usb_dp_qmpphy) to succeed -- with this one stuck as a never-loading
# module, dwc3-qcom's own probe was permanently blocked regardless of how
# long snps-eusb2-hsphy's own (separate, now-resolved) dependency took.
# PHY_QCOM_QMP_COMBO has `depends on DRM || DRM=n` -- Kconfig's
# consistent-module-state rule means it can't be =y while DRM is =m (a
# built-in driver can't safely depend on a module that might not be
# loaded). At the time this was first hit there was no working DRM-based
# display path, so `# CONFIG_DRM is not set` satisfied the `DRM=n`
# alternative. 2026-09-05 (Session 5): reversed now that display bring-up
# is actually in scope -- `DRM=y` satisfies the exact same dependency just
# as well as `DRM=n` does (confirmed: ubuntu-galaxy-tab-s9ultra's own
# fragment builds DRM=y alongside PHY_QCOM_QMP_COMBO=y with no conflict,
# config-gts9uwifi.fragment:4-6). Building DRM in is the correct branch,
# not a workaround -- see the "Display / DRM / panel" block below.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_SNPS_EUSB2=y

# Fifth instance of this exact bug class (Storage bring-up session):
# CONFIG_PHY_QCOM_QMP_UFS defaults to =m, so ufs_mem_phy's driver never
# binds on this modprobe-less rootfs -- ufs_mem_hc's `phys = <&ufs_mem_phy>`
# dependency then never resolves, and the UFS controller sits in permanent
# EPROBE_DEFER forever ("deferred probe pending: ufshcd-qcom:
# ufshcd_pltfrm_init() failed", confirmed live via the USB serial console
# -- no "probe of 1d80000.phy returned ..." trace ever appears at all,
# unlike ufshc's own repeated deferred-probe trace, because with no driver
# bound the platform-driver-core probe() callback is never invoked in the
# first place). Force it built-in.
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_PHY_NXP_PTN3222=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_BATTERY_SM5714=y
CONFIG_TYPEC_SM5714=y
CONFIG_TYPEC_MUX_GPIO_SBU=y
CONFIG_TYPEC_MUX_PS5169=y

# Display / DRM / panel (Session 5, 2026-09-05). mainline's sm8550.dtsi
# already ships complete mdss/dpu/dsi/dispcc nodes (status = "disabled"
# by default) -- nothing to add upstream, just build the driver stack and
# enable the nodes in the board DTS. There is no mainline driver for this
# panel (Samsung/Anapass ANA38407 DDIC, part AMSA10FA01), so
# kernel/drivers/panel-samsung-ana38407-x716.c is a from-scratch driver
# for it (forked from ubuntu-galaxy-tab-s9ultra's own from-scratch driver
# for the same DDIC family, different physical part -- see that file's
# header and docs/porting-log.md's Session 5 entry). Config names/values
# below mirror config-gts9uwifi.fragment:1-6,142-170 (proven working on
# the sibling SM8550 board), which is also the proof this whole block is
# Kconfig-consistent with the CONFIG_PHY_QCOM_QMP_COMBO=y fix above.
#
# All built-in (=y), not modules -- same reasoning as everywhere else in
# this fragment: no rootfs/modprobe exists at this bring-up stage.
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_QCOM_LLCC=y
CONFIG_SM_GPUCC_8550=y
CONFIG_SM_DISPCC_8550=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_SAMSUNG_ANA38407_X716=y

# Same "consistent module state" Kconfig class as the earlier
# CONFIG_PHY_QCOM_QMP_COMBO fix: DRM_MSM has three more
# `depends on X || X=n` clauses (QCOM_AOSS_QMP, QCOM_OCMEM,
# QCOM_COMMAND_DB) alongside QCOM_LLCC's. Found by actually building this
# fragment and reading merge_config.sh's own MISMATCH report rather than
# guessing: QCOM_AOSS_QMP/QCOM_COMMAND_DB already resolved to =y on their
# own from other selectors, but QCOM_OCMEM defaulted to =m with nothing
# else forcing it -- the one that needed an explicit fix here.
CONFIG_QCOM_OCMEM=y

# Suspend/resume test infrastructure -- the ANA38407 DDIC family is known
# (from the sibling port's bring-up) to answer a cold-boot ID readback
# with garbage and only recover after one suspend/resume cycle. pm_test
# runs the driver .prepare/.suspend/.resume callback chain without
# actually cutting SoC power or needing a real wakeup source configured,
# which is what the bring-up ramdisk's /init uses to trigger that
# recovery cycle early in boot (see scripts/build-bringup-ramdisk.sh).
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_TEST_SUSPEND=y

# Touchscreen: fts1ba90a, from-scratch driver (no usable mainline driver
# exists for this chip -- see docs/hardware-facts.md and
# kernel/drivers/touchscreen-fts1ba90a-x716.c's own header for why).
# CONFIG_INPUT_TOUCHSCREEN is already =y by mainline defconfig.
CONFIG_TOUCHSCREEN_FTS1BA90A_X716=y

# S Pen: Wacom WEZ01 EMR digitizer (gts9wifi-fedora pivot). Presence on
# this exact X716B unit confirmed via a real on-device wez01_gts9.bin
# firmware blob -- see kernel/dts/sm8550-samsung-x716b.dts's i2c3 node.
# From-scratch driver, same reasoning as the touchscreen/panel drivers
# below (no usable mainline driver for this chip).
CONFIG_TOUCHSCREEN_WACOM_WEZ01_X716=y

# &i2c4 (the touchscreen's bus) never probed on real hardware even after the
# Session 7 regulator fix -- confirmed via a live serial-console session:
# `a90000.i2c: deferred probe pending: geni_i2c: Failed to get tx DMA ch`,
# forever, because mainline's defconfig ships CONFIG_QCOM_GPI_DMA=m and this
# board's rootfs (both the debug ramdisk and the Buildroot/Weston image)
# never loads kernel modules -- so gpi_dma1/gpi_dma2 (dma-controller@a00000
# and @800000 in sm8550.dtsi) never bind, and every QUP I2C/SPI bus that
# depends on either of them (not just i2c4 -- i2c6 too, per its own `dmas =
# <&gpi_dma1 ...>` property) is stuck in permanent deferred-probe. Force it
# built-in instead of a module -- see docs/porting-log.md's Session 7 entry.
CONFIG_QCOM_GPI_DMA=y

# WiFi/BT (Networking bring-up session): this device's real combo chip is
# Qualcomm QCA6490 per its own stock DTS (`qcom,cnss-qca6490`) -- earlier
# docs wrongly assumed WCN7850, the sibling X910 Ultra's chip, a different
# chip family entirely. Real-hardware probing later found the WLAN half
# identifies to ath11k as "wcn6855 hw2.1" (MHI SoC-ID readback) while the
# BT half identifies to hci_qca as "ROME/QCA6390" (HCI version readback)
# -- two different mainline-driver identities for the same physical chip,
# both real measurements; see docs/hardware-facts.md and
# docs/porting-log.md's Session 8 entry. WiFi is ath11k over PCIe0;
# Bluetooth is hci_qca/btqca over UART14. Same "no modprobe available" bug
# class as CONFIG_QCOM_GPI_DMA above and CONFIG_PHY_QCOM_QMP_UFS (see the
# UFS section) -- mainline defconfig defaults every symbol in this chain
# to =m; force the whole chain =y.
CONFIG_PHY_QCOM_QMP_PCIE=y
# MAC80211 depends on CFG80211; BT's own menuconfig has "depends on
# RFKILL || !RFKILL" -- looks like a tautology in plain boolean logic, but
# Kconfig evaluates tristate deps with tristate logic, where
# "RFKILL || !RFKILL" with RFKILL=m evaluates to "m || n" = "m", not "y" --
# so forcing BT=y without also forcing RFKILL=y gets silently downgraded
# back to =m by dependency resolution (confirmed live: the fragment's own
# post-build verification step caught this exact mismatch).
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
# Verbose ath11k QMI/WMI/boot/BDF tracing, gated at runtime by
# /sys/module/ath11k/parameters/debug_mask (0 by default, so no runtime
# cost until enabled). Added during the WiFi-throughput / Samsung-BDF
# investigation (see docs/wifi-samsung-calibration.md) where reading the
# exact QMI+WMI command sequence out of dmesg was essential to
# root-causing a firmware crash; kept because it is cheap and useful for
# any future WiFi work. Not required by any fix.
CONFIG_ATH11K_DEBUG=y
CONFIG_MHI_BUS=y
CONFIG_QRTR=y
CONFIG_QRTR_MHI=y
CONFIG_BT=y
CONFIG_BT_QCA=y
CONFIG_BT_HCIUART=y
# Missed this one on the first pass -- confirmed live via dmesg:
# "deferred probe pending: platform: wait for supplier /wcn-pmu/regulators/
# ldoN" forever, because the wcn-pmu platform device (compatible
# "qcom,qca6390-pmu") never had a driver to bind at all (=m, no modprobe
# available here -- same bug class, again).
CONFIG_POWER_SEQUENCING_QCOM_WCN=y

# BT HID input (real hardware report: a paired Bluetooth keyboard and
# touchpad produced no keystrokes/pointer movement, even though the radio
# itself was fine). Root cause: CONFIG_UHID was entirely absent -- BlueZ's
# `input` plugin creates a virtual HID device via /dev/uhid for any paired
# keyboard/mouse/touchpad, which the kernel's generic HID core then turns
# into a real evdev device; without it, pairing can succeed but no input
# ever reaches the kernel. kernel/config/config-mainline.aarch64 (now
# vendored from gts9wifi-fedora's own comprehensive base) already sets
# these, but force them here too, belt-and-suspenders, in case dependency
# resolution against this project's specific patched tree disturbs them --
# matches gts9wifi-fedora's own board fragment, which asserts the same
# symbols explicitly on top of its base for the same reason. See
# docs/porting-log.md.
CONFIG_UHID=y
CONFIG_HIDRAW=y
# Legacy BR/EDR-only HIDP kernel-side profile; not what modern BlueZ
# actually uses (uhid above is), but built-in for completeness/robustness
# rather than left at defconfig's =m with no modprobe path available here.
CONFIG_BT_HIDP=y

# Internal audio + sensors, step 1: the ADSP (audio DSP / SSC) remoteproc
# (gts9wifi-fedora pivot, matching their config-gts9wifi.fragment's own
# reasoning verbatim -- same "no modprobe available" bug class as every
# =m default fixed above). Firmware is Samsung's own signed adsp.mdt
# (extracted from the apnhlos partition, same TWRP-based method as the
# GPU zap/GMU firmware already pulled -- see &remoteproc_adsp's own DTS
# comment). This is the foundation both q6 audio and SSC sensors sit on.
CONFIG_REMOTEPROC=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_PDR_MSG=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR_SMD=y

# Sensors, step 2: Samsung's sensor protection domain is started by
# userspace through FastRPC. Without a built-in FastRPC driver the ADSP
# announces fastrpcglink-apps-dsp yet /dev/fastrpc-adsp never exists,
# hexagonrpcd (Phase 3) cannot attach sensorspd, and the SSC QMI service
# is never published. Defaults to =m; this port doesn't autoload modules.
CONFIG_QCOM_FASTRPC=y

# Internal audio, step 2: AudioReach/GPR, the SM8550 machine card, the
# CS35L45 I2C/MI2S speaker path, and the LPASS VA macro used by its
# DMICs. The generic mainline config leaves this whole graph at =m; the
# visible roots must be =y (their own selects pull q6apm/q6afe/q6prm,
# WM_ADSP and QCOM PDR helpers up to =y too).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SOUNDWIRE=y
CONFIG_QCOM_APR=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC_SC8280XP=y
CONFIG_SND_SOC_CS35L45_I2C=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y
CONFIG_PINCTRL_LPASS_LPI=y
CONFIG_PINCTRL_SM8550_LPASS_LPI=y

# The four CS35L45 instances share their physical reset line (TLMM
# GPIO42) and mainline routes shared reset lines like this through the
# GPIO shared-proxy driver. Its default is =m; without module autoload
# every codec gets -EPROBE_DEFER even though TLMM/GPIO42 are both valid.
CONFIG_GPIO_SHARED_PROXY=y

# PPS direct-charge pump (SM5440) and its battery-thermistor ADC channel
# (&pmk8550's pmk8550_vadc, wired into sm5714_charger's io-channels).
CONFIG_CHARGER_SM5440_DIRECT=y
CONFIG_QCOM_SPMI_ADC5_GEN3=y

# PMIC RTC (drivers/rtc/rtc-pm8xxx.c, matched to pmk8550.dtsi's
# `pmk8550_rtc: rtc@6100` via "qcom,pmk8350-rtc"; that node ships enabled
# with a dedicated "alarm" reg bank + alarm IRQ). Mainline defconfig and
# our vendored base both leave it =m, and this port never modprobes -- so
# with no built-in RTC driver there is no `rtc0`, and an ALARM_BOOTTIME
# alarm has no wake-capable RTC backing it. sm5440_direct.c's suspend
# keepalive (2026-09-10 charging work) needs a real wakealarm to re-Request
# the PPS APDO every few seconds across s2ram; force the driver built-in so
# `/sys/class/rtc/rtc0/wakealarm` exists. Falls back gracefully if the RTC
# still fails to register (keepalive_capable check), but on this SoC the
# node is present and functional.
CONFIG_RTC_DRV_PM8XXX=y

# DisplayPort altmode link-training helpers. TYPEC_DP_ALTMODE (re-added
# above) and the internal DP path both need these; DRM_MSM's own =y
# likely already pulls DRM_DISPLAY_HELPER/DP_HELPER in transitively, but
# listed explicitly rather than assumed given this is genuinely new
# territory (Type-C DP altmode) for this port.
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_DISPLAY_DP_HELPER=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y

# Physical power/volume keys (kernel/dts/sm8550-samsung-x716b.dts's
# &pon_pwrkey/&pon_resin/gpio-keys nodes): confirmed via three independent
# sources (gts9wifi-fedora/X710, ubuntu-galaxy-tab-s9ultra/X910, and this
# exact device's own stock downstream kernel) that pwrkey and resin are
# children of the PMK8550 pon@1300 node, and that parent is matched by
# qcom-pon.c (POWER_RESET_QCOM_PON). Left at its mainline-default =m this
# parent never probes on this port -- which does not autoload modules --
# so the children are never created and only the gpio-keys Volume Up
# works, silently leaving Power and Volume Down dead. Built-in.
# CONFIG_KEYBOARD_GPIO and CONFIG_INPUT_PM8941_PWRKEY are already =y in
# defconfig at the pinned tag -- only this one needs overriding.
CONFIG_POWER_RESET_QCOM_PON=y

# Force SELinux back OFF. The old defconfig-based base (before
# config-mainline.aarch64 was replaced with gts9wifi-fedora's vendored
# base, see that file's header) never had CONFIG_SECURITY_SELINUX
# compiled in at all (CONFIG_DEFAULT_SECURITY_DAC=y, no "selinux" in
# CONFIG_LSM=) -- so despite /etc/selinux/config claiming "permissive"
# the whole time, SELinux was actually a complete no-op on every prior
# boot of this project. The new base turns it on for real. Confirmed
# live on real hardware: with it on, every socket-activated core unit
# (systemd-journald, dbus, systemd-udevd, systemd-logind, systemd-oomd,
# systemd-resolved, systemd-coredump, systemd-userdbd, and more) fails
# at boot with "Failed to determine SELinux label: Invalid argument" /
# "Failed with result 'resources'" -- Fedora 44's shipped selinux-policy
# isn't compatible with this bleeding-edge v7.2 pinned kernel's SELinux
# policy/class ABI. No working desktop, no D-Bus, nothing socket-based
# at all. Setting /etc/selinux/config to SELINUX=disabled and rebooting
# (live diagnostic test, not this fix) confirmed the diagnosis cleanly:
# every one of those failures disappeared. Getting a real, working
# SELinux policy on this kernel is its own future task, not something
# this session's hardware-support work needs -- force back off here,
# restoring exactly what was actually running (successfully) in every
# prior session. See docs/porting-log.md for the full debugging story.
CONFIG_SECURITY_SELINUX=n

# Explicitly NOT enabled here (see docs/hardware-facts.md non-goals):
# camera, cellular modem remoteproc, hardware video decode (iris) --
# gts9wifi-fedora's own reference doesn't ship these either (camera/
# fingerprint confirmed absent from that project entirely; iris is
# explicitly `❌` in their own README), so "same quality as the Wi-Fi
# version" excludes them here too. GPU acceleration and audio DSP/
# sensors, previously listed here as deferred, are no longer -- see the
# Display/DRM block above and the ADSP/audio/sensors block above this
# comment, both landed as part of the gts9wifi-fedora pivot.

# kernel/config/config-mainline.aarch64's new comprehensive base (vendored
# from gts9wifi-fedora) defaults to full CONFIG_DEBUG_INFO=y (DWARF),
# which reintroduces the exact final-link-step OOM this project's old,
# smaller config-mainline.aarch64 used to prevent on this dev machine (a
# shared 14GB desktop, not a dedicated build box -- confirmed by
# reproducing the failure previously: every object file compiled cleanly
# at -j4, only the single, unparallelizable final `LD vmlinux.o` step got
# killed). No debugger session is planned for this bring-up; re-assert
# the fix here so it survives the base-config swap.
CONFIG_DEBUG_INFO_NONE=y
