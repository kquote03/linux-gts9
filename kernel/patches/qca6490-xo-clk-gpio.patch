--- a/drivers/power/sequencing/pwrseq-qcom-wcn.c
+++ b/drivers/power/sequencing/pwrseq-qcom-wcn.c
@@ -324,7 +324,26 @@
 	.num_vregs = ARRAY_SIZE(pwrseq_qca6390_vregs),
 	.pwup_delay_ms = 60,
 	.gpio_enable_delay_ms = 100,
-	.targets = pwrseq_qcom_wcn_targets,
+	/*
+	 * Confirmed live on real hardware (Networking bring-up session,
+	 * QCA6490 board): both patch #1 (PHY pipe-mux unpark) and patch #2
+	 * (AOP PDC votes) applied together still left the WLAN PCIe endpoint
+	 * undetected ("Device not found" -- LTSSM stuck in Detect.Quiet,
+	 * meaning the far-end receiver termination was never even seen).
+	 * This board's own stock DTS drives an XO-clock-enable GPIO
+	 * (qcom,xo-clk-gpio, GPIO 204) as part of *both* the WLAN and BT
+	 * halves of this exact chip's power-up sequence -- a real,
+	 * board-confirmed requirement mainline never wired up for the
+	 * QCA6390/QCA6490 pdata table (only wcn6855's table gained the
+	 * generic xo-clk-assert/deassert unit, even though the mechanism
+	 * itself is chip-agnostic). Reusing pwrseq_qcom_wcn6855_targets here
+	 * (rather than a new qca6490-specific target array) is deliberate:
+	 * it is the exact same xo-clk-assert-before-enable,
+	 * xo-clk-deassert-after-enable sequence, just previously gated
+	 * behind wcn6855's pdata only. See docs/porting-log.md's Networking
+	 * bring-up session entry.
+	 */
+	.targets = pwrseq_qcom_wcn6855_targets,
 	.cold_reset_wlan = true,
 };
 
@@ -514,6 +533,23 @@
 		return dev_err_probe(dev, -ENODEV,
 				     "Failed to obtain platform data\n");
 
+	/*
+	 * Send the AOP WLAN PDC votes first, before any regulator/GPIO is
+	 * even requested -- confirmed (Networking bring-up session, via
+	 * downstream cnss2 source: cnss_probe(), main.c) that Samsung's own
+	 * driver calls cnss_aop_mbox_init()/cnss_aop_pdc_reconfig() (sends
+	 * every PDC vote) strictly before cnss_get_resources() (the call
+	 * that first acquires regulators/clocks/pinctrl, i.e. WLAN_EN/BT_EN).
+	 * Originally this call was placed after the WLAN GPIO/clock
+	 * acquisition below; moving it here makes the ordering byte-for-byte
+	 * faithful to real hardware's own probe sequence instead of an
+	 * approximation. See docs/porting-log.md's Networking bring-up
+	 * session entry.
+	 */
+	ret = pwrseq_qcom_wcn_program_wlan_pdc(dev);
+	if (ret)
+		return ret;
+
 	ctx->regs = devm_kcalloc(dev, ctx->pdata->num_vregs,
 				 sizeof(*ctx->regs), GFP_KERNEL);
 	if (!ctx->regs)
@@ -579,10 +615,6 @@
 		return dev_err_probe(dev, PTR_ERR(ctx->clk),
 				     "Failed to get the reference clock\n");
 
-	ret = pwrseq_qcom_wcn_program_wlan_pdc(dev);
-	if (ret)
-		return ret;
-
 	memset(&config, 0, sizeof(config));
 
 	config.parent = dev;
