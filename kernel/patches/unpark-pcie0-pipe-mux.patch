--- a/drivers/phy/qualcomm/phy-qcom-qmp-pcie.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-pcie.c
@@ -4981,6 +4981,23 @@
 	if (ret)
 		return ret;

+	/*
+	 * The GCC PIPE source muxes power up selecting the PHY output and no
+	 * mainline code switches them, but Samsung's SM8550 (kalama) boot
+	 * chain parks PCIe0's mux on the XO reference (the register reads
+	 * PHY_MUX_REF_SRC, 19.2 MHz). With the mux parked the MAC-PHY PIPE
+	 * interface is dead and the LTSSM never performs receiver detection,
+	 * so the WLAN endpoint is never found ("Device not found" in dmesg --
+	 * confirmed live on real hardware, Networking bring-up session:
+	 * DT wiring, regulators, GPIOs, power sequencing all checked out fine,
+	 * yet the link never trained, matching this exact symptom). ULONG_MAX
+	 * is the clk-regmap-phy-mux sentinel for "select the PHY source",
+	 * propagated by the branch's CLK_SET_RATE_PARENT. Imported verbatim
+	 * from the sibling X910 Ultra port's own out-of-tree patch
+	 * (ubuntu-galaxy-tab-s9ultra/kernel/patches/unpark-pcie0-pipe-mux.patch,
+	 * itself inherited from a physically-validated postmarketOS kernel) --
+	 * this is a SoC/PHY-IP-level boot-chain quirk shared by the whole
+	 * Samsung SM8550 family, not specific to either board's WLAN chip.
+	 * See docs/porting-log.md's Networking bring-up session entry.
+	 */
+	clk_set_rate(qmp->pipe_clks[0].clk, ULONG_MAX);
+
 	ret = reset_control_deassert(qmp->nocsr_reset);
 	if (ret) {
 		dev_err(qmp->dev, "no-csr reset deassert failed\n");
