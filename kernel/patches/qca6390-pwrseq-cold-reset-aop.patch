+/*
+ * Samsung's cnss2 programs the AOP WLAN PDC resources through the QMP
+ * mailbox before the first WCN power-on. This board's real stock DTS
+ * carries a qcom,pdc_init_table for its QCA6490 chip that votes the RF
+ * rail up/down levels and enables the baseband PDC resource; without
+ * these votes the PMU never completes its power handshake and the PCIe
+ * receivers stay undetected -- confirmed live on real hardware
+ * (Networking bring-up session): the PHY pipe-clock-mux fix
+ * (unpark-pcie0-pipe-mux.patch) alone was not sufficient, "Device not
+ * found" persisted until this was added too. Boards opt in with a
+ * qcom,qmp phandle plus qcom,wlan-pdc-init strings; everything else is
+ * skipped silently. Adapted from the sibling X910 Ultra port's own
+ * out-of-tree patch for its (different) WCN7850 chip
+ * (wcn7850-pwrseq-cold-reset-aop.patch) -- see
+ * docs/porting-log.md's Networking bring-up session entry.
+ */
+static int pwrseq_qcom_wcn_program_wlan_pdc(struct device *dev)
+{
+	struct property *prop;
+	struct qmp *qmp;
+	const char *msg;
+
+	if (!of_property_present(dev->of_node, "qcom,qmp"))
+		return 0;
+
+	qmp = qmp_get(dev);
+	if (IS_ERR(qmp))
+		return dev_err_probe(dev, PTR_ERR(qmp),
+				     "Failed to get the AOP QMP mailbox\n");
+
+	of_property_for_each_string(dev->of_node, "qcom,wlan-pdc-init",
+				    prop, msg)
+		qmp_send(qmp, "%s", msg);
+
+	qmp_put(qmp);
+
+	return 0;
+}
