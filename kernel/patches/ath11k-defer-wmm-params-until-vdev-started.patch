--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -25,6 +25,41 @@
 #include "hif.h"
 #include "wow.h"
 
+/* Quirk (WiFi throughput / Samsung BDF investigation, Galaxy Tab S9 5G
+ * port): Samsung's real, version-matched WLAN.HSP.2.0 firmware for
+ * QCA6490/WCN6855 crashes hard (MHI_CB_EE_RDDM, confirmed via RDDM
+ * coredump + Hexagon disassembly to be an unguarded NULL-pointer
+ * dereference in wal_pdev->[0x37c]) whenever the host sends
+ * WMI_VDEV_SET_WMM_PARAMS_CMDID (legacy type). Confirmed NOT a
+ * vdev-start timing issue: deferring the send to after vdev_start still
+ * crashes at the same ~880 ms delay with correct values, and all three
+ * vdev-lifecycle call sites crash identically. The exact fault
+ * instruction exists 3x in this firmware and 0x in the community
+ * WLAN.HSP.1.1 build. Skipping the send is the only host-side
+ * workaround (the firmware is PIL-signed); host-configured WMM/EDCA
+ * tuning is lost when it is active -- mac80211/firmware fall back to
+ * their own defaults. See docs/wifi-samsung-calibration.md.
+ *
+ *   -1 (default) = auto: skip only when the running firmware build id
+ *                  contains "WLAN.HSP.2.0" (the affected generation);
+ *                  a no-op on the community HSP.1.1 firmware this port
+ *                  ships by default.
+ *    0           = always send (old behaviour).
+ *    1           = always skip.
+ */
+static int ath11k_skip_legacy_wmm_params = -1;
+module_param_named(skip_legacy_wmm_params, ath11k_skip_legacy_wmm_params, int, 0644);
+MODULE_PARM_DESC(skip_legacy_wmm_params,
+		 "skip WMI_VDEV_SET_WMM_PARAMS (legacy): -1=auto (WLAN.HSP.2.0 only), 0=never, 1=always -- firmware-bug workaround");
+
+static bool ath11k_mac_skip_legacy_wmm_params(struct ath11k *ar)
+{
+	if (ath11k_skip_legacy_wmm_params >= 0)
+		return ath11k_skip_legacy_wmm_params;
+
+	return strstr(ar->ab->qmi.target.fw_build_id, "WLAN.HSP.2.0") != NULL;
+}
+
 #define CHAN2G(_channel, _freq, _flags) { \
 	.band                   = NL80211_BAND_2GHZ, \
 	.hw_value               = (_channel), \
@@ -5511,9 +5546,37 @@ static int ath11k_mac_op_conf_tx(struct ieee80211_hw *hw,
 	p->aifs = params->aifs;
 	p->txop = params->txop;
 
-	ret = ath11k_wmi_send_wmm_update_cmd_tlv(ar, arvif->vdev_id,
-						 &arvif->wmm_params,
-						 WMI_WMM_PARAM_TYPE_LEGACY);
+	/* mac80211 calls conf_tx() at interface-up time (ieee80211_set_wmm_
+	 * default(), called from ieee80211_do_open()) before any chanctx --
+	 * and therefore vdev_start -- has ever happened for this vif. At
+	 * that point the values above are cached into arvif->wmm_params,
+	 * but the actual WMI_VDEV_SET_WMM_PARAMS_CMDID send (and the mu_edca/
+	 * uapsd sends below, which touch the same not-yet-configured vdev
+	 * state) is deferred until the vdev has genuinely started --
+	 * ath11k_mac_op_assign_vif_chanctx() / ath11k_mac_start_vdev_delay()
+	 * flush the cached params once arvif->is_started goes true. Sending
+	 * WMI_VDEV_SET_WMM_PARAMS this early also lets ath11k ship three
+	 * all-zero AC entries on the first of mac80211's four per-AC calls.
+	 * (Deferral does NOT by itself fix the Samsung WLAN.HSP.2.0 firmware
+	 * crash -- that handler faults regardless of when the command
+	 * arrives; ath11k_mac_skip_legacy_wmm_params() handles that.)
+	 * Mainline's own "TODO: Setup ps and cts/rts protection" comment in
+	 * assign_vif_chanctx() already flags this exact class of gap for a
+	 * different feature. See docs/wifi-samsung-calibration.md (Galaxy
+	 * Tab S9 5G port) for the full analysis.
+	 */
+	if (!arvif->is_started) {
+		ret = 0;
+		goto exit;
+	}
+
+	if (ath11k_mac_skip_legacy_wmm_params(ar)) {
+		ret = 0;
+	} else {
+		ret = ath11k_wmi_send_wmm_update_cmd_tlv(ar, arvif->vdev_id,
+							 &arvif->wmm_params,
+							 WMI_WMM_PARAM_TYPE_LEGACY);
+	}
 	if (ret) {
 		ath11k_warn(ar->ab, "failed to set wmm params: %d\n", ret);
 		goto exit;
@@ -7957,6 +8020,26 @@ static int ath11k_mac_start_vdev_delay(struct ieee80211_hw *hw,
 
 	arvif->is_started = true;
 
+	/* Flush WMM params deferred by ath11k_mac_op_conf_tx() -- see the
+	 * comment there. This is the path that actually transitions
+	 * is_started to true for hw_params.vdev_start_delay chips (this
+	 * device's wcn6855 hw2.1 included: a STA vdev's first
+	 * assign_vif_chanctx() call returns early, before ever reaching
+	 * ath11k_mac_op_assign_vif_chanctx()'s own copy of this flush, because
+	 * no peer exists yet -- is_started only goes true later, here, once
+	 * the bss peer is created. Both flush sites are needed; which one
+	 * actually runs depends on hw_params.vdev_start_delay.
+	 */
+	if (arvif->vdev_type != WMI_VDEV_TYPE_MONITOR &&
+	    !ath11k_mac_skip_legacy_wmm_params(ar)) {
+		ret = ath11k_wmi_send_wmm_update_cmd_tlv(ar, arvif->vdev_id,
+							 &arvif->wmm_params,
+							 WMI_WMM_PARAM_TYPE_LEGACY);
+		if (ret)
+			ath11k_warn(ab, "failed to set wmm params on delayed vdev start for vdev %i: %d\n",
+				    arvif->vdev_id, ret);
+	}
+
 	/* TODO: Setup ps and cts/rts protection */
 	return 0;
 }
@@ -8456,6 +8539,30 @@ ath11k_mac_op_assign_vif_chanctx(struct ieee80211_hw *hw,
 		}
 	}
 
+	/* Flush WMM params conf_tx() cached into arvif->wmm_params but
+	 * deferred (rather than sent immediately) because the vdev wasn't
+	 * started yet at the time -- see the comment in
+	 * ath11k_mac_op_conf_tx() for why. arvif->is_started is now true
+	 * (either just set above, or it was already true and this call is a
+	 * later chanctx reassignment, in which case re-sending the current
+	 * cached values is harmless). mu_edca/uapsd don't need an equivalent
+	 * flush here: mac80211 only configures those once real AP capability
+	 * info is known, which happens post-association -- i.e. after the
+	 * vdev is already started, so their own conf_tx() call goes through
+	 * normally without ever needing to be deferred.
+	 */
+	if (arvif->vdev_type != WMI_VDEV_TYPE_MONITOR &&
+	    !ath11k_mac_skip_legacy_wmm_params(ar)) {
+		ret = ath11k_wmi_send_wmm_update_cmd_tlv(ar, arvif->vdev_id,
+							 &arvif->wmm_params,
+							 WMI_WMM_PARAM_TYPE_LEGACY);
+		if (ret) {
+			ath11k_warn(ab, "failed to set wmm params on vdev start for vdev %i: %d\n",
+				    arvif->vdev_id, ret);
+			goto out;
+		}
+	}
+
 	/* TODO: Setup ps and cts/rts protection */
 
 	ret = 0;
