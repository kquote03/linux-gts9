# Reference/input material — each is its own git repo or a raw firmware dump,
# not part of this project's history.
/android_kernel_samsung_gts9/
/ubuntu-galaxy-tab-s9ultra/
/sm-x800-linux/
/2026-09-04--*/

# Proprietary Samsung/vendor firmware blobs pulled from the real device's
# /vendor/firmware (2026-09-06, via `adb pull` while mounted read-only under
# TWRP -- see docs/porting-log.md). Needed as build/runtime input (e.g. the
# fts1ba90a touch controller's firmware, tsp_stm/fts1ba90a_gts8p.bin) but not
# ours to redistribute -- never commit these.
/vendor-firmware-dump/

# Build scratch and output
/work/
/out/

# Fetched mainline kernel source (pinned via scripts/fetch-mainline.sh, not vendored —
# too large to commit; docs/hardware-facts.md records the exact pinned commit instead)
/kernel/linux/

# Fetched uniLoader source (pinned via scripts/fetch-uniloader.sh, not vendored —
# active upstream project; our own board/SoC additions live in uniloader-overlay/
# instead, which IS committed)
/uniloader/upstream/

# Fetched Buildroot source (pinned via scripts/fetch-buildroot.sh, not vendored —
# active upstream project; our own board config/overlay live in buildroot/configs/
# and buildroot/rootfs-overlay/ instead, which ARE committed)
/buildroot/upstream/

# Large binary artifacts — never commit these, they're build output
*.img
*.win
*.win.md5
*.dtb
*.dtbo
Image.gz*
*.ko
*.tar
*.tar.gz
*.tar.xz

# Editor/OS cruft
.DS_Store
*.swp
__pycache__/
*.pyc

# Claude Code session state
/.claude/
